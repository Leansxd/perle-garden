{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-d", "upload_max_filesize=100M",
        "-d", "post_max_size=210M",
        "-d", "memory_limit=512M",
        "-S", "127.0.0.1:8000",
        "-t", "app/public",
        "app/server.php"
      ],
      "port": 8000
    }
  ]
}
